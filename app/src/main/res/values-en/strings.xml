    <!-- Privacy Policy Screen -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_intro_title">1. Introduction</string>
    <string name="privacy_intro_content">Welcome to Oly: Feed and Chats. We value your privacy and are committed to protecting your personal data. This policy explains how we collect, use, and protect your information.</string>
    <string name="privacy_data_collection_title">2. Information We Collect</string>
    <string name="privacy_data_collection_content">We collect information that you provide directly, such as your username, email address, profile photo, and messages sent. We also collect technical data automatically, such as IP address and device information to ensure security and the functioning of the service.</string>
    <string name="privacy_use_title">3. Use of Information</string>
    <string name="privacy_use_content">Your information is used to provide and improve our messaging services, authenticate your account, prevent fraud, and personalize your experience. We do not sell your data to third parties.</string>
    <string name="privacy_security_title">4. Data Protection</string>
    <string name="privacy_security_content">We use technical and organizational security measures to protect your data against unauthorized access, loss, or alteration. Your messages are stored securely and only you and the recipient have access to the content, respecting the privacy of conversations.</string>
    <string name="privacy_rights_title">5. Your Rights</string>
    <string name="privacy_rights_content">You have the right to access, correct, or delete your personal data at any time through the app settings. You can also request the definitive deletion of your account, which will permanently remove your information from our servers.</string>
    <string name="privacy_changes_title">6. Changes to this Policy</string>
    <string name="privacy_changes_content">We may update this policy periodically. We will notify you of significant changes through the app or other communication channels.</string>
    <string name="privacy_contact_title">7. Contact</string>
    <string name="privacy_contact_content">If you have questions about our privacy policy, please contact us via in-app support.</string>
    <string name="privacy_last_updated">Last updated: March 2026</string>

